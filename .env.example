# Prefer npm run setup to generate random values. Never commit .env.
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgres://openiot:replace-with-long-random-password@127.0.0.1:5432/openiot_m1
# 32 random bytes, base64-encoded; used only on the backend.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
APP_ORIGIN=http://localhost:5173
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# For production behind a local reverse proxy only:
# TRUST_PROXY=loopback
# APP_ORIGIN=https://iot.example.com
# NODE_ENV=production
