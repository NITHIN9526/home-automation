{
  "name": "open-iot-milestone-1",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"npm run dev --workspace web\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "npm run build --workspace web",
    "simulate": "node --env-file-if-exists=.device.env scripts/simulator.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "aedes": "1.2.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "mqtt": "5.16.0",
    "pg": "8.16.3",
    "ws": "8.22.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.56.1",
    "concurrently": "10.0.6"
  }
}
